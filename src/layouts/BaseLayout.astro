---
import { jsonForScript } from '../lib/markdown';
import { getSite, getActiveTheme, getActiveNotice } from '../lib/content';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import ogDefault from '../assets/photos/neues-gebaeude.jpg';
import { dir, localizePath, basePath, withBase, useTranslations, type Lang } from '../i18n/ui';
const site = getSite();

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { lang, title, description, image = ogDefault, noindex = false, schema = [] } = Astro.props;
const t = useTranslations(lang);
const path = basePath(Astro.url.pathname);
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const canonical = siteUrl + localizePath(path, lang);
const altDe = siteUrl + localizePath(path, 'de');
const altAr = siteUrl + localizePath(path, 'ar');
const brand = lang === 'ar' ? 'مسجد محمد الأمين – هانوفر' : 'Mohammad Al-Amien Moschee Hannover';
const fullTitle = title === brand ? title : `${title} · ${brand}`;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC || 'https://plausible.io/js/script.js';
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const demo = import.meta.env.PUBLIC_DEMO === '1';
const theme = getActiveTheme();
const notice = getActiveNotice();
const themeColor = { wine: '#6b1f2f', green: '#23622f', navy: '#1a2847', ramadan: '#2b2350' }[theme];
const favicon = theme === 'wine' ? '/favicon.svg' : `/favicon-${theme}.svg`;
// Test builds only: links to the same page in both colour variants on GitHub Pages.
const demoRoot = import.meta.env.PUBLIC_DEMO_ROOT || '';
const relPath = localizePath(path, lang).slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const variants = [
  { id: 'wine', label: lang === 'ar' ? 'خمري (الملصق)' : 'Weinrot (Flyer)', href: demoRoot + relPath },
  { id: 'green', label: lang === 'ar' ? 'أخضر (الشعار)' : 'Grün (Logo)', href: demoRoot + '/gruen' + relPath },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Mosque', 'PlaceOfWorship'],
  name: site.mosqueName,
  alternateName: [site.mosqueNameAr, 'Vahrenwalder Moschee', site.orgName],
  url: siteUrl,
  telephone: site.phone,
  email: site.email,
  image: siteUrl + og.src,
  foundingDate: String(site.founded),
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressCountry: 'DE' },
  parentOrganization: { '@type': 'NGO', name: site.orgName, url: siteUrl },
  sameAs: [site.social.telegram, site.social.youtubeUrl, site.social.instagram].filter(Boolean),
};
---
<!doctype html>
<html lang={lang} dir={dir(lang)} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="ar" href={altAr} />
    <link rel="alternate" hreflang="x-default" href={altDe} />
    {(noindex || demo) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase(favicon)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + og.src} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonForScript([orgSchema, ...schema])} />

    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc}></script>}
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only z-[60] rounded-full bg-wine px-4 py-2 text-white focus:not-sr-only focus:fixed focus:start-4 focus:top-4">{t('nav.skip')}</a>
    {demo && (
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 bg-gold-soft px-4 py-2 text-center text-sm font-semibold text-wine-ink" role="note">
        <span>{lang === 'ar' ? 'نسخة تجريبية – المحتوى أولي والدفع الإلكتروني ونموذج التواصل غير مفعّلين.' : 'Testversion – Inhalte vorläufig, Online-Zahlung und Kontaktformular sind deaktiviert.'}</span>
        {demoRoot && (
          <span class="inline-flex items-center gap-1.5">
            {lang === 'ar' ? 'اللون:' : 'Farbe:'}
            {variants.map((v) => (
              <a href={v.href} aria-current={v.id === theme ? 'true' : undefined} class="inline-flex items-center gap-1.5 rounded-full border border-wine-ink/25 bg-white/50 px-3 py-0.5 hover:bg-white aria-[current=true]:border-wine-ink aria-[current=true]:bg-wine-ink aria-[current=true]:text-white">
                <span class="size-2.5 rounded-full" style={`background:${v.id === 'green' ? '#69b86b' : '#8e2c3f'}`}></span>{v.label}
              </a>
            ))}
          </span>
        )}
      </div>
    )}
    {notice && (
      <div class:list={['px-4 py-2.5 text-center text-[0.95rem] font-semibold', notice.tone === 'brand' ? 'bg-wine text-white' : 'bg-gold-pale text-wine-ink']} role="status">
        <span class="container-x inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          <span>{lang === 'ar' && notice.text_ar ? notice.text_ar : notice.text_de}</span>
          {notice.link && <a href={notice.link.startsWith('/') ? localizePath(notice.link, lang) : notice.link} class="underline underline-offset-4">{lang === 'ar' ? 'المزيد' : 'Mehr erfahren'}</a>}
        </span>
      </div>
    )}
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {googleAdsId && <ConsentBanner lang={lang} adsId={googleAdsId} />}
    {demo && (
      <script is:inline define:vars={{ msg: lang === 'ar' ? 'هذه نسخة تجريبية: الدفع الإلكتروني ونموذج التواصل غير مفعّلين. يمكنك التبرع عبر التحويل البنكي.' : 'Testversion: Online-Zahlung und Kontaktformular sind hier deaktiviert. Spenden Sie gerne per Überweisung.' }}>
        document.addEventListener('submit', function (e) {
          if ((e.target.getAttribute('action') || '').indexOf('/api/') !== -1) { e.preventDefault(); alert(msg); }
        });
      </script>
    )}
  </body>
</html>
