---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AIcon from '../../../components/admin/AIcon.astro';
import PageHead from '../../../components/admin/PageHead.astro';
import { adminT } from '../../../admin/i18n';
import { currentUser, guardArea, guardSudo, setFlash, str, clientIp } from '../../../admin/util';
import { audit } from '../../../lib/server/auth';
import { listBackups, runBackup, uploadStats } from '../../../lib/server/backup';
import { fmtDate } from '../../../components/admin/people/helpers';

const denied = guardArea(Astro, 'backup');
if (denied) return denied;
const sudo = guardSudo(Astro);
if (sudo) return sudo;
const { user } = currentUser(Astro);
const t = adminT(user.lang);
const lang = user.lang;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (str(fd, 'action', 20) === 'run') {
    try {
      const name = runBackup();
      audit(user, 'backup.run', name, { file: name, ip: clientIp(Astro) }, true);
      setFlash(Astro, { type: 'ok', key: 'backup.created' });
    } catch (err) {
      console.error('[backup] manual backup failed', err);
      setFlash(Astro, { type: 'error', key: 'flash.error' });
    }
  }
  return Astro.redirect('/admin/sicherung#automatisch', 303);
}

const backups = listBackups();
const uploads = uploadStats();
const nf = new Intl.NumberFormat(lang === 'ar' ? 'ar-u-nu-latn' : 'de-DE', { maximumFractionDigits: 1 });
const size = (b: number) => b < 1024 * 1024 ? `${nf.format(b / 1024)} KB` : `${nf.format(b / 1024 / 1024)} MB`;
---
<AdminLayout title={t('backup.title')} active="users">
  <PageHead title={t('backup.title')} intro={t('backup.intro')} back={{ href: '/admin/benutzer', label: t('users.title') }} />

  <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] content-start gap-4">
      <section class="a-card">
        <div class="flex flex-wrap items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-wine text-white"><AIcon name="download" size={22} /></span>
          <div class="min-w-0 flex-1 basis-60">
            <h2 class="a-section-title">{t('backup.download')}</h2>
            <p class="mt-0.5 text-[13px] a-muted">{t('backup.downloadText')}</p>
          </div>
          <a href="/admin/sicherung/download" class="a-btn a-btn-primary max-sm:w-full" download><AIcon name="download" size={15} />{t('backup.download')}</a>
        </div>
      </section>

      <section id="automatisch" class="a-card scroll-mt-20">
        <div class="a-card-title"><span>{t('backup.nightly')} · {backups.length}</span></div>
        <p class="-mt-1 mb-2 text-[13px] a-muted">{t('backup.nightlyText')}</p>
        {backups.length === 0 ? <p class="a-empty !py-6">{t('backup.none')}</p> : (
          <ul class="a-list">
            {backups.map((b) => (
              <li class="a-row !py-2">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-paper-2 text-ink-soft"><AIcon name="calendar" size={16} /></span>
                <span class="min-w-0 flex-1 leading-tight">
                  <b class="block text-[13.5px]">{fmtDate(lang, b.mtime, { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' })}</b>
                  <small class="a-muted"><span dir="ltr">{b.name}</span> · <span dir="ltr">{size(b.size)}</span> · {fmtDate(lang, b.mtime, { hour: '2-digit', minute: '2-digit' })}</small>
                </span>
                <a href={`/admin/sicherung/download?datei=${encodeURIComponent(b.name)}`} class="a-btn a-btn-sm" download><AIcon name="download" size={14} /><span class="max-sm:sr-only">{t('backup.file')}</span></a>
              </li>
            ))}
          </ul>
        )}
        <form method="post" class="mt-3 flex justify-end border-t border-paper-2 pt-3">
          <input type="hidden" name="action" value="run" />
          <button class="a-btn a-btn-sm"><AIcon name="refresh" size={14} />{t('backup.runNow')}</button>
        </form>
      </section>
    </div>

    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] content-start gap-4">
      <section class="a-card">
        <div class="flex items-start gap-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gold-pale text-[#7a5a2c]"><AIcon name="image" /></span>
          <div class="min-w-0">
            <h2 class="a-section-title">{t('backup.images')}</h2>
            <p class="mt-0.5 break-words text-[13px] a-muted">{t('backup.imagesText', { dir: '⁨' + uploads.dir + '⁩', count: uploads.count, size: '⁨' + size(uploads.size) + '⁩' })}</p>
          </div>
        </div>
      </section>
      <section class="a-card">
        <div class="flex items-start gap-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-paper-2 text-ink-soft"><AIcon name="refresh" /></span>
          <div class="min-w-0">
            <h2 class="a-section-title">{t('backup.restore')}</h2>
            <p class="mt-0.5 text-[13px] a-muted">{t('backup.restoreText')}</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>
