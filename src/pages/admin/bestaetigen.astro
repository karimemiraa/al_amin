---
export const prerender = false;
import AuthLayout from '../../layouts/AuthLayout.astro';
import { adminT } from '../../admin/i18n';
import { adminLang, safeNext, clientIp, currentUser } from '../../admin/util';
import { checkPassword, verifySecondFactor, grantSudo, hasSudo, audit, ipBlocked, isLocked, recordPasswordFailure } from '../../lib/server/auth';

const { user, session } = currentUser(Astro);
const next = safeNext(Astro.url.searchParams.get('next'));
if (hasSudo(session)) return Astro.redirect(next, 302);
const lang = adminLang(Astro);
const t = adminT(lang);
let error = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const ip = clientIp(Astro);
  // Wrong passwords count like failed logins, wrong codes like failed 2FA (both lock the account).
  const blocked = ipBlocked(ip) || isLocked(user.id);
  const passwordOk = !blocked && checkPassword(user.id, String(fd.get('password') ?? ''));
  if (!blocked && !passwordOk) recordPasswordFailure(user.id, ip);
  const ok = passwordOk && (!user.totpEnabled || verifySecondFactor(user.id, String(fd.get('code') ?? ''), ip) !== null);
  if (ok) {
    grantSudo(session.id);
    audit(user, 'security.confirmed', next, { ip }, true);
    return Astro.redirect(next, 303);
  }
  audit(user, 'security.confirmFailed', next, { ip }, true);
  error = blocked || isLocked(user.id) ? t('auth.locked') : t('sudo.invalid');
}
---
<AuthLayout title={t('sudo.title')} lang={lang}>
  <span class="grid size-12 place-items-center rounded-2xl bg-gold-pale text-[#7a5a2c]"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3" /></svg></span>
  <h1 class="mt-4 font-display text-[1.6rem] font-semibold leading-tight">{t('sudo.title')}</h1>
  <p class="mt-2 a-muted">{t('sudo.text')}</p>
  {error && <p class="mt-5 rounded-xl border border-[#e8b4b0] bg-[#fdf0ef] px-4 py-3 text-[13.5px] font-semibold text-[#8a2a2a]" role="alert">{error}</p>}
  <form method="post" class="mt-6 grid gap-4">
    <label class="a-field"><span class="a-label">{t('auth.password')}</span><input class="a-input !h-11" type="password" name="password" required autofocus autocomplete="current-password" /></label>
    {user.totpEnabled && <label class="a-field"><span class="a-label">{t('auth.2faCode')}</span><input class="a-input a-code-input !h-12 !text-xl" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="11" required dir="ltr" placeholder="000000" /></label>}
    <button class="a-btn a-btn-primary !h-11 w-full">{t('sudo.submit')}</button>
    <a href="/admin" class="text-center text-[13px] font-semibold a-muted">{t('common.cancel')}</a>
  </form>
</AuthLayout>
