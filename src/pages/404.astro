---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import { withBase } from '../i18n/ui';
---
<BaseLayout lang="de" title="Seite nicht gefunden" description="Die gesuchte Seite wurde nicht gefunden. Zur Startseite der Mohammad Al-Amien Moschee Hannover." noindex>
  <section class="bg-paper-grain">
    <div class="container-x flex flex-col items-center py-20 text-center md:py-28">
      <p class="font-display text-[6rem] font-semibold leading-none text-wine/15 md:text-[9rem]" aria-hidden="true">404</p>
      <p class="eyebrow both -mt-2">Seite nicht gefunden</p>
      <h1 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight md:text-5xl">Diese Seite gibt es leider nicht (mehr).</h1>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">
        Vielleicht hat sich die Adresse geändert, oder es hat sich ein Tippfehler eingeschlichen. Von hier aus finden Sie
        schnell weiter:
      </p>
      <p class="mt-5 max-w-xl text-xl text-wine-ink" lang="ar" dir="rtl" style="font-family: var(--font-arabic); line-height: 1.9;">
        عذراً، الصفحة التي تبحث عنها غير موجودة. <a href={withBase('/ar')} class="font-semibold text-wine underline underline-offset-4">الانتقال إلى الصفحة الرئيسية</a>
      </p>

      <Ornament class="my-10" />

      <ul class="grid w-full max-w-3xl gap-3 sm:grid-cols-3">
        <li>
          <a href={withBase('/')} class="card group flex h-full flex-col items-center gap-3 p-6 transition hover:-translate-y-0.5 hover:border-gold-soft hover:shadow-lift">
            <span class="grid size-12 place-items-center rounded-full bg-gold-pale text-wine"><Icon name="moon" size={22} /></span>
            <span class="text-lg font-semibold text-ink group-hover:text-wine">Startseite</span>
            <span class="text-sm text-ink-mute" lang="ar" dir="rtl">الصفحة الرئيسية</span>
          </a>
        </li>
        <li>
          <a href={withBase('/gebetszeiten')} class="card group flex h-full flex-col items-center gap-3 p-6 transition hover:-translate-y-0.5 hover:border-gold-soft hover:shadow-lift">
            <span class="grid size-12 place-items-center rounded-full bg-gold-pale text-wine"><Icon name="clock" size={22} /></span>
            <span class="text-lg font-semibold text-ink group-hover:text-wine">Gebetszeiten</span>
            <span class="text-sm text-ink-mute" lang="ar" dir="rtl">مواقيت الصلاة</span>
          </a>
        </li>
        <li>
          <a href={withBase('/spenden')} class="card group flex h-full flex-col items-center gap-3 p-6 transition hover:-translate-y-0.5 hover:border-gold-soft hover:shadow-lift">
            <span class="grid size-12 place-items-center rounded-full bg-wine text-white"><Icon name="heart" size={22} /></span>
            <span class="text-lg font-semibold text-ink group-hover:text-wine">Spenden</span>
            <span class="text-sm text-ink-mute" lang="ar" dir="rtl">تبرّع</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
