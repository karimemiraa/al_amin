---
import mark from '../assets/brand/mark.svg?raw';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; tone?: 'dark' | 'light'; class?: string }
const { lang, tone = 'dark', class: cls = '' } = Astro.props;
const markSvg = mark.replace('<svg', '<svg aria-hidden="true" class="h-full w-auto"');
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <span class:list={['h-8 shrink-0 sm:h-9 md:h-10', tone === 'dark' ? 'text-wine' : 'text-gold-soft']} set:html={markSvg} />
  <span class="flex flex-col leading-none">
    {lang === 'ar' ? (
      <>
        <span class:list={['whitespace-nowrap font-arabic text-[1.2rem] font-bold leading-tight sm:text-[1.35rem]', tone === 'dark' ? 'text-ink' : 'text-white']}>مسجد محمد الأمين</span>
        <span class:list={['whitespace-nowrap text-[0.62rem] font-medium tracking-wide sm:text-[0.7rem]', tone === 'dark' ? 'text-ink-mute' : 'text-white/70']}>Mohammad Al-Amien Moschee · هانوفر</span>
      </>
    ) : (
      <>
        <span class:list={['font-display text-[1rem] font-semibold leading-[1.05] tracking-tight sm:whitespace-nowrap sm:text-[1.15rem] md:text-[1.25rem]', tone === 'dark' ? 'text-ink' : 'text-white']}>Mohammad <br class="sm:hidden" />Al-Amien</span>
        <span class:list={['mt-1 hidden whitespace-nowrap text-[0.68rem] font-semibold uppercase tracking-[0.18em] sm:block', tone === 'dark' ? 'text-gold' : 'text-gold-soft']}>Moschee · Hannover</span>
      </>
    )}
  </span>
</span>
