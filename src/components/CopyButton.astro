---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { value: string; lang: Lang; label?: string; class?: string }
const { value, lang, label, class: cls = '' } = Astro.props;
const t = useTranslations(lang);
---
<button type="button" data-copy={value} data-copied-label={t('common.copied')} class:list={['inline-flex items-center gap-1.5 rounded-full border border-current/25 px-3 py-1 text-sm font-semibold transition hover:border-current/60', cls]} aria-label={label ?? `${t('common.copy')}: ${value}`}>
  <Icon name="copy" size={15} /><span data-copy-text>{t('common.copy')}</span>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const text = btn.querySelector('[data-copy-text]');
      const original = text?.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (text) text.textContent = btn.dataset.copiedLabel ?? '✓';
        setTimeout(() => { if (text && original) text.textContent = original; }, 1800);
      } catch { /* clipboard unavailable: user can still select the text */ }
    });
  });
</script>
