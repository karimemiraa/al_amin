---
/**
 * Field for an encrypted credential. Never renders the stored value: shows a masked hint
 * (e.g. "sk_live_…a1B2") and where it comes from. Empty input = keep the current value.
 * The remove button posts `clear=<secretKey>` with the surrounding form.
 */
import AIcon from '../AIcon.astro';
import type { T } from '../../../admin/i18n';
interface Props {
  t: T; name: string; label: string; source: 'admin' | 'env' | null; masked: string;
  hint?: string; error?: string; placeholder?: string; maxlength?: number;
}
const { t, name, label, source, masked, hint, error, placeholder, maxlength = 400 } = Astro.props;
const id = `secret-${name}`;
---
<div class="a-field">
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
    <label class="a-label" for={id}><AIcon name="key" size={14} class="text-ink-mute" />{label}</label>
    <span class="flex items-center gap-1.5">
      {source === 'admin' && <span class="a-chip a-chip-live"><span class="a-dot"></span>{t('pay.secret.admin')}</span>}
      {source === 'env' && <span class="a-chip a-chip-scheduled"><span class="a-dot"></span>{t('pay.secret.env')}</span>}
      {!source && <span class="a-chip a-chip-draft">{t('pay.secret.none')}</span>}
    </span>
  </div>
  {masked && (
    <div class="flex items-center justify-between gap-2 rounded-[10px] border border-dashed border-line bg-paper/70 px-3 py-1.5 text-[13px]">
      <span class="min-w-0 truncate"><span class="a-muted">{t('pay.secret.current')}:</span> <code dir="ltr" class="font-mono text-[12.5px] font-semibold text-ink">{masked}</code></span>
      {source === 'admin' && (
        <button type="submit" name="clear" value={name} formnovalidate class="a-btn a-btn-sm a-btn-ghost a-btn-danger !h-7 !px-2" data-confirm={t('pay.secret.removeConfirm')}>
          <AIcon name="trash" size={13} />{t('pay.secret.remove')}
        </button>
      )}
    </div>
  )}
  <div class="relative">
    <input
      id={id} class="a-input !pe-10 font-mono text-[13px]" type="password" name={name} dir="ltr" maxlength={maxlength}
      autocomplete="new-password" spellcheck="false" autocapitalize="off" data-1p-ignore data-lpignore="true"
      placeholder={placeholder ?? (source ? t('pay.secret.placeholderKeep') : t('pay.secret.placeholderNew'))}
      aria-invalid={error ? 'true' : undefined} aria-describedby={hint ? `${id}-hint` : undefined}
    />
    <button type="button" class="absolute inset-y-0 end-0 grid w-10 place-items-center text-ink-mute hover:text-wine" data-secret-toggle aria-label={t('pay.secret.toggle')} title={t('pay.secret.toggle')}><AIcon name="eye" size={16} /></button>
  </div>
  {hint && <span class="a-hint" id={`${id}-hint`}>{hint}</span>}
  {error && <span class="a-error-text">{error}</span>}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-secret-toggle]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const input = btn.parentElement?.querySelector('input');
      if (input) input.type = input.type === 'password' ? 'text' : 'password';
    });
  });
</script>
