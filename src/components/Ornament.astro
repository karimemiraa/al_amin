---
// Gold flourish divider inspired by the flyer's section ornaments.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={['flex items-center justify-center gap-3 text-gold', cls]} aria-hidden="true">
  <span class="h-px w-16 bg-gradient-to-r from-transparent to-gold-soft md:w-24"></span>
  <svg width="64" height="16" viewBox="0 0 64 16" fill="none" stroke="currentColor" stroke-width="1.1">
    <path d="M32 2.5l4 5.5-4 5.5-4-5.5z" fill="currentColor" fill-opacity=".15" />
    <path d="M24 8c-3.5 0-5-3-8.5-3S11 8 8 8M40 8c3.5 0 5-3 8.5-3S53 8 56 8" />
    <path d="M24 8c-3.5 0-5 3-8.5 3S11 8 8 8M40 8c3.5 0 5 3 8.5 3S53 8 56 8" opacity=".6" />
    <circle cx="4" cy="8" r="1.4" fill="currentColor" /><circle cx="60" cy="8" r="1.4" fill="currentColor" />
  </svg>
  <span class="h-px w-16 bg-gradient-to-l from-transparent to-gold-soft md:w-24"></span>
</div>
