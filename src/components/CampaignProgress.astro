---
import { getCampaign } from '../lib/content';
import { formatEuro, formatNumber, formatDate, useTranslations, type Lang } from '../i18n/ui';
const campaign = getCampaign();

interface Props { lang: Lang; tone?: 'light' | 'dark'; class?: string }
const { lang, tone = 'light', class: cls = '' } = Astro.props;
const t = useTranslations(lang);
const pct = Math.min(100, (campaign.raised / campaign.goal) * 100);
const sqm = Math.floor(campaign.raised / campaign.pricePerSqm);
const dark = tone === 'dark';
const deadlineTs = new Date(campaign.deadline + 'T23:59:59+01:00').getTime();
const daysLeft = Math.max(0, Math.ceil((deadlineTs - Date.now()) / 86_400_000));
---
<div class:list={['w-full', cls]} data-campaign-progress>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
    <p>
      <span dir="ltr" class:list={['inline-block font-display text-4xl font-semibold tabular md:text-5xl', dark ? 'text-white' : 'text-wine']}>{formatEuro(campaign.raised)}</span>
      <span class:list={['ms-1 text-[0.95rem]', dark ? 'text-white/75' : 'text-ink-soft']}>{t('campaign.raised')}</span>
    </p>
    <p class:list={['text-[0.95rem]', dark ? 'text-white/75' : 'text-ink-soft']}>
      {t('campaign.goal')}: <strong dir="ltr" class:list={['inline-block', dark ? 'text-white' : 'text-ink']}>{formatEuro(campaign.goal)}</strong>
    </p>
  </div>

  <div class:list={['relative mt-4 h-3.5 overflow-hidden rounded-full', dark ? 'bg-white/15' : 'bg-paper-3']} role="progressbar" aria-valuemin="0" aria-valuemax={campaign.goal} aria-valuenow={campaign.raised} aria-label={`${formatEuro(campaign.raised)} ${t('campaign.of')} ${formatEuro(campaign.goal)}`}>
    <div class="absolute inset-y-0 start-0 rounded-full bg-gradient-to-r from-gold via-gold-soft to-gold shadow-[0_0_12px_rgb(217_195_157/0.6)]" style={`width:${Math.max(pct, 1.5)}%`}></div>
    {[25, 50, 75].map((m) => <span class:list={['absolute inset-y-0 w-px', dark ? 'bg-white/25' : 'bg-white/80']} style={`inset-inline-start:${m}%`}></span>)}
  </div>

  <dl class="mt-4 grid grid-cols-3 gap-3">
    <div>
      <dt class:list={['text-xs uppercase tracking-wider', dark ? 'text-white/60' : 'text-ink-mute']}>%</dt>
      <dd dir="ltr" class:list={['font-display text-lg font-semibold tabular sm:text-xl', dark ? 'text-white' : 'text-ink']}>{pct.toLocaleString('de-DE', { maximumFractionDigits: 1 })} %</dd>
    </div>
    <div>
      <dt class:list={['text-xs uppercase tracking-wider', dark ? 'text-white/60' : 'text-ink-mute']}>{t('campaign.sqm')}</dt>
      <dd dir="ltr" class:list={['whitespace-nowrap font-display text-lg font-semibold tabular sm:text-xl', dark ? 'text-white' : 'text-ink']}>{formatNumber(sqm)} / {formatNumber(campaign.totalSqm)}</dd>
    </div>
    <div>
      <dt class:list={['text-xs uppercase tracking-wider', dark ? 'text-white/60' : 'text-ink-mute']}>{t('campaign.daysLeft')}</dt>
      <dd class:list={['font-display text-lg font-semibold tabular sm:text-xl', dark ? 'text-white' : 'text-ink']} data-days-left={deadlineTs}>{daysLeft}</dd>
    </div>
  </dl>

  <p class:list={['mt-3 text-xs', dark ? 'text-white/60' : 'text-ink-mute']}>
    {t('campaign.asOf')}: {formatDate(campaign.asOf, lang)}
    {campaign.donors > 0 && <> · {formatNumber(campaign.donors)} {t('campaign.donors')}</>}
    · {t('campaign.deadline')}: {formatDate(campaign.deadline, lang)}
  </p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-days-left]').forEach((el) => {
    el.textContent = String(Math.max(0, Math.ceil((Number(el.dataset.daysLeft) - Date.now()) / 86_400_000)));
  });
</script>
