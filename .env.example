# Copy to .env on the server. Never commit the real .env.

# Master key that encrypts stored credentials (Stripe/SMTP) – generate once with:
#   openssl rand -base64 32
# Never change it afterwards (stored credentials would become unreadable), never commit it.
APP_SECRET=

# Optional: fixed one-time link for the very first admin setup (/admin/setup?token=…).
# If empty, a link is generated and printed to the server log (docker compose logs web).
SETUP_TOKEN=

# Where the database, uploads and backups live (Docker: a volume mounted at /app/data)
DATA_DIR=./data

# Public URL of the site (used for Stripe redirect URLs)
PUBLIC_SITE_URL=https://www.igh-hannover.de

# Stripe, SMTP and the translation key are best entered in the admin (/admin → Zahlungen & E-Mail).
# The values below are only a fallback / first-start default.
# Stripe (Dashboard → Developers → API keys). Use sk_test_… for testing.
STRIPE_SECRET_KEY=

# Contact form e-mail delivery (SMTP of your mail provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=kontakt@igh-hannover.de
CONTACT_FROM=website@igh-hannover.de

# Optional, cookieless analytics (Plausible). Leave empty to disable.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Optional, Google Ads conversion tracking (only loads after consent). Leave empty to disable.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_DONATION_LABEL=

HOST=0.0.0.0
PORT=4321
