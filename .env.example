# Copy to .env on the server. Never commit the real .env.

# Public URL of the site (used for Stripe redirect URLs)
PUBLIC_SITE_URL=https://www.igh-hannover.de

# Stripe (Dashboard → Developers → API keys). Use sk_test_… for testing.
STRIPE_SECRET_KEY=

# Contact form e-mail delivery (SMTP of your mail provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=kontakt@igh-hannover.de
CONTACT_FROM=website@igh-hannover.de

# Optional, cookieless analytics (Plausible). Leave empty to disable.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Optional, Google Ads conversion tracking (only loads after consent). Leave empty to disable.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_DONATION_LABEL=

HOST=0.0.0.0
PORT=4321
